OPENAI_API_KEY=
# Modelo original: retiro anunciado para 2027-01-14; selecciona otro compatible antes de esa fecha.
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_DRIVE_FOLDER_ID=
VECTOR_STORE_ID=
# El ID se toma de /folders/ID; no pegues la URL completa.
# No amplía el alcance salvo activación explícita.
DRIVE_INCLUDE_SUBFOLDERS=false
# Rutas relativas a la carpeta del proyecto o absolutas fuera de OneDrive.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
# Opcional; la interfaz permite introducirla en memoria (X-Admin-Key).
LOCAL_ADMIN_KEY=
PORT=5000
# Límites de consumo, red e indexación.
API_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
INDEX_POLL_TIMEOUT_SECONDS=180
OAUTH_TIMEOUT_SECONDS=180
MAX_FILE_BYTES=20971520
DRIVE_MAX_FILES=200
SEARCH_MAX_RESULTS=12
MAX_OUTPUT_TOKENS=3000
REQUESTS_PER_MINUTE=20
# Local conserva la sincronización interactiva con Google Drive.
DEPLOYMENT_MODE=local
# Solo para el despliegue: genera estos valores con scripts/prepare_cloud.py.
APP_ACCESS_KEY=
DOCUMENT_MANIFEST_JSON=
